{
  "family": "stack-gateway",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "__EXEC_ROLE__",
  "taskRoleArn": "__TASK_ROLE__",
  "containerDefinitions": [
    {
      "name": "gateway",
      "image": "__IMAGE_URI__:__IMAGE_TAG__",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4400,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "STACK_GATEWAY_PORT",
          "value": "4400"
        },
        {
          "name": "STACK_GATEWAY_REQUIRE_ITEM",
          "value": "true"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "__PARAM_PREFIX__/DATABASE_URL"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "__PARAM_PREFIX__/ANTHROPIC_API_KEY"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "__LOG_GROUP__",
          "awslogs-region": "__REGION__",
          "awslogs-stream-prefix": "gateway"
        }
      },
      "command": [
        "npm",
        "-w",
        "@stack/gateway",
        "run",
        "start"
      ]
    }
  ]
}
