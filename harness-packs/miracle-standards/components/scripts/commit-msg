#!/usr/bin/env bash
# Miracle standards blocker: every commit must carry a Stack AI item handle.
# Installed by `stack harness install` into .git/hooks/commit-msg.
set -euo pipefail

MSG_FILE="$1"
MSG="$(cat "$MSG_FILE")"
REPO_ROOT="$(git rev-parse --show-toplevel)"
CONFIG="$REPO_ROOT/stack.toml"

read_toml() {
  # minimal reader: read_toml <key> <default>
  local key="$1" default="$2" value=""
  if [ -f "$CONFIG" ]; then
    value="$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$CONFIG" | head -1 | sed -E 's/^[^=]*=[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/')"
  fi
  printf '%s' "${value:-$default}"
}

PATTERN="$(read_toml commit_item_pattern 'STACK-[0-9]+')"
PORTAL="$(read_toml portal_url '')"
PROJECT="$(read_toml project '')"
TOKEN_FILE="$HOME/.stack/credentials.json"

# Merge commits and reverts generated by git are exempt.
case "$MSG" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

if ! printf '%s' "$MSG" | grep -qE "$PATTERN"; then
  cat >&2 <<EOF

  Commit rejected by the Miracle harness.

  Every commit must reference a Stack AI item, pattern: $PATTERN
  Your message:
      $(printf '%s' "$MSG" | head -1)

  Fix it like this:
      STACK-123: $(printf '%s' "$MSG" | head -1)

  Open items:  stack issues --mine
  Why:         the item handle joins commits and status in the portal.

EOF
  exit 1
fi

HANDLE="$(printf '%s' "$MSG" | grep -oE "$PATTERN" | head -1)"

# Second check, when the developer is logged in: the item must be claimed by them.
if [ -n "$PORTAL" ] && [ -f "$TOKEN_FILE" ] && command -v curl >/dev/null 2>&1; then
  TOKEN="$(sed -E 's/.*"token"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/' "$TOKEN_FILE" 2>/dev/null || true)"
  if [ -n "${TOKEN:-}" ]; then
    RESPONSE="$(curl -fsS --max-time 4 \
      -H "Authorization: Bearer $TOKEN" \
      "$PORTAL/api/issues/$HANDLE/precommit?project=$PROJECT" 2>/dev/null || true)"
    if printf '%s' "$RESPONSE" | grep -q '"ok":false'; then
      REASON="$(printf '%s' "$RESPONSE" | sed -E 's/.*"reason"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/')"
      cat >&2 <<EOF

  Commit rejected by the Miracle harness.

  $HANDLE: ${REASON:-item is not claimed by you or is not in progress}

  Claim it first:  stack claim $HANDLE

EOF
      exit 1
    fi
  fi
fi

exit 0
