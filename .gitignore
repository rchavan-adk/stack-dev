node_modules/
.next/
dist/
out/
*.tsbuildinfo

# local database and generated artefacts
*.db
*.db-journal
packages/db/prisma/*.db
.harness-cache/
harness-dist/

# mock github remote and developer workspace created by the demo
mock-github/*.git/
mock-github/workspace/

# local credentials written by the stack CLI
.stack/
.env
.env.local

# Everything under secrets/ is a credential of some kind: the Anthropic key, and
# tokens captured while verifying a deployment. Ignore the whole directory rather
# than listing files one by one, so a new secret cannot be committed by accident
# because nobody remembered to add it here.
secrets/

# per-repo webhook secret a local hook reads before signing a delivery
stack-webhook-secret

# os junk
.DS_Store
