  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@stack/core": "*"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
